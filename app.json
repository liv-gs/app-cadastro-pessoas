{
  "expo": {
    "name": "Cadastro de Pessoas",
    "slug": "app-teste",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/perfil.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.livia.cadastroapp",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/perfil.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/perfil.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O app precisa da câmera para fotografar os documentos.",
          "photosPermission": "O app precisa acessar suas fotos para anexar documentos."
        }
      ]
    ]
  }
}